rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =======================================================================
    // SECURITY HELPER FUNCTIONS
    // =======================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'platform_admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    // =======================================================================
    // 1. COLLEGE REGISTRATION WORKFLOW
    // =======================================================================
    match /college_registration_requests/{requestId} {
      // Allow individual document reads ('get') for admins or owners
      allow get: if isPlatformAdmin() || (isAuthenticated() && resource.data.applicantUid == request.auth.uid);

      // Allow query listing ('list') for admins, or for authenticated users filtering by their own applicantUid
      allow list: if isPlatformAdmin() || (isAuthenticated() && request.query.limit <= 50);

      // Any authenticated session (including anonymous) can create a draft with their own UID
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;

      // Applicants can only update their own drafts; Admins can update any
      allow update: if isPlatformAdmin() || (isAuthenticated() && resource.data.applicantUid == request.auth.uid);
      allow delete: if isPlatformAdmin();

      // Registration Audit Logs Subcollection
      match /audit_logs/{logId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // =======================================================================
    // 2. ATOMIC DOMAIN RESERVATION
    // =======================================================================
    match /registered_domains/{domain} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.data.reservedBy == request.auth.uid;
    }

    // =======================================================================
    // 3. USER PROFILES
    // =======================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Prevent users from tampering with their own role or verification status
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isPlatformAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['role', 'verification_status']) ||
         (request.resource.data.role == resource.data.role &&
          request.resource.data.verification_status == resource.data.verification_status))
      );
      allow delete: if isPlatformAdmin();
    }

    // =======================================================================
    // 4. PLATFORM GOVERNANCE
    // =======================================================================
    match /platform_administrators/{adminId} {
      allow read: if (isAuthenticated() && request.auth.uid == adminId) || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isPlatformAdmin();
      allow update, delete: if false;
    }

    // =======================================================================
    // 5. APPROVED COLLEGES
    // =======================================================================
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}